# Service wiring for the qlane test stack (docker-compose.qlane.yml). Every value here is a
# throwaway for an ephemeral sandbox; nothing here is used outside it.
ALLOWED_HOSTS=*
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=qlane-netbox-db
REDIS_HOST=redis
REDIS_PASSWORD=qlane-netbox-redis
REDIS_DATABASE=0
REDIS_SSL=false
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PASSWORD=qlane-netbox-redis
REDIS_CACHE_DATABASE=1
REDIS_CACHE_SSL=false
SECRET_KEY=qlane-fixture-throwaway-django-secret-key-for-an-ephemeral-sandbox-only
API_TOKEN_PEPPER_1=qlane-fixture-throwaway-token-pepper-for-an-ephemeral-sandbox-only
MEDIA_ROOT=/opt/netbox/netbox/media
WEBHOOKS_ENABLED=true
RELEASE_CHECK_URL=
EMAIL_SERVER=localhost
EMAIL_PORT=25
EMAIL_FROM=netbox@example.com
