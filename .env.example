# Variables for docker-compose.qlane.yml. Set each on the Qlane test target; the stack
# refuses to start while any of them is empty.

# Django's secret key, 50 or more characters.
NETBOX_SECRET_KEY=
# The API token pepper, 50 or more characters.
NETBOX_API_TOKEN_PEPPER=
# The password of the QA account (username qa), created on first boot.
QA_PASSWORD=
